{
  "name": "techive",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --prefix packages/shared && npm run build --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "build:shared": "npm run build --prefix packages/shared",
    "build:api": "npm run build --prefix apps/api"
  }
}
