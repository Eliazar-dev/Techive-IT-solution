{
  "name": "techive",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build --prefix shared && npm run build --prefix frontend && npm run build --prefix backend",
    "build:web": "npm run build --prefix frontend",
    "build:shared": "npm run build --prefix shared",
    "build:api": "npm run build --prefix backend"
  }
}
