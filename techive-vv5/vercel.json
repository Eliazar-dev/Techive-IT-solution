{
  "installCommand": "npm install",
  "buildCommand": "npm run build:shared && npm run build:web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/apps/api/src/index.ts" },
    { "source": "/((?!api/|assets/|favicon).*)", "destination": "/index.html" }
  ]
}
